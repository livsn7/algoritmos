programa {
  funcao inicio() {
    inteiro opcao
    escreva("Escolha(1-3):")
    leia (opcao)

    escolha(opcao){
      caso 1:
      escreva("Cadastratar usuario")
      pare
      caso 2:
      escreva("Listar Usuários")
      pare
      caso 3:
      escreva("Sair do Sistema")
      pare
      caso contrario:
      escreva("Opçao Inválida")
    }
  }
}
