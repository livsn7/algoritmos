programa {
  funcao inicio() {
    cadeia senha

        escreva("Digite a senha: ")
        leia(senha)

        enquanto (t.numero_caracteres(senha) < 6)
        {
            escreva("Senha fraca! Digite novamente: ")
            leia(senha)
        }

        escreva("Senha cadastrada!")
    }
  }
}
