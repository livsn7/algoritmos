programa {
  funcao inicio() {
    cadeia nome
    inteiro quantidadeItenscomprados
    real  valorTotalapagar
    logico  confirmacaodefreteGratuitoporregiao

    nome = "ps5"
    quantidadeItenscomprados = 1
    valorTotalapagar =  4.499
    confirmacaodefreteGratuitoporregiao = verdadeiro

    escreva("===== CARRINHO DE COMPRAS =====\n")
    escreva("Produto:",nome,"\n")
    escreva("Quantidade:",quantidadeItenscomprados,"\n")
    escreva("Valor Total:",valorTotalapagar,"\n")
    escreva("Confirmação de frete gratuito por região:",confirmacaodefreteGratuitoporregiao,"\n")


  }
}
