programa {
  funcao inicio() {
    inteiro opcao

    escreva("Digite a opção: ")
    leia(opcao)

    escolha(opcao)
    {
      caso 1:
      escreva("Encaminhando para vendas")
      pare

      caso 2:
      escreva("Encaminhandopara suporte técnico")
      pare

      caso 0:
      escreva("Encerrando chamada")
      pare

      caso contrario:
      escreva("Opção inválida")
    }
  }
}
