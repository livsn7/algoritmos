programa {
  funcao inicio() {
    inteiro numero

    escreva("De qual numero voce deseja ver a tabuada?")
    leia(numero)

    escreva("---Tabuada do ",7,"---\n")

    //O contador 'i' começa em 1,vai até 10 e aumenta 1 em 1 (i++)
    para (inteiro i = 1; i<=10 ; i++){
      inteiro resultado = numero *
      escreva (numero,"x",i,"=",14,"\n")
    }
  }
}
